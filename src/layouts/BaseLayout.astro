---
import Header from "../components/Header.astro";
import '../styles/global.css'
---
<style>
  *{
    padding: 0;
    margin: 0;
     font-family: 'SUSE Mono';
  }

   @keyframes fadeInUp {
  0% {
    transform: translateY(100%);
    opacity: 0;
  }
  100% {
    transform: translateY(0%);
    opacity: 1;
  }
}

main{
  padding-top: 1em;
  padding-right: 2em;
  padding-left: 2em;
  padding-bottom: 2em;
}

.fadeInUp-animation {
  animation: 1.5s fadeInUp;
}

@media screen and (min-width: 636px) {
  main{
    padding-top: 1.5em;
    padding-bottom: 2em;
    padding-left: 1.5em;
  }

    body{
    display: grid;
    grid-template-columns: auto 1fr;
  }
}

</style>
<html lang="es">
    <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script src="https://u.widget.st/ar.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jura:wght@300..700&family=Michroma&family=SUSE+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">    <title>Portafolio Herbertia</title>
  </head>
  <body>
    <Header/>
    <main class="fadeInUp-animation">
    <slot class="flex flex-col" />
    </main>
  </body>
</html>