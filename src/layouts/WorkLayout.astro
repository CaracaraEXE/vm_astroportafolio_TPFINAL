---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { Carousel, Breadcrumb } from 'webcoreui/astro';
import Categories from "../components/Categories.astro";
import {YouTube} from 'astro-embed';
import '../styles/hover.css';
import '../styles/global.css';

const { work } = Astro.props;

const breadcrumbs = [
    {label: 'Proyectos', href: '/works'},
    {label: `${work.title}`, href: `/works/${work.slug}`}
]

---
<style>
    a, ul{
        font-family: 'Michroma';
    }

    audio::-webkit-media-controls-panel{
        background-color: white;
    }

    audio::-webkit-media-controls-play-button{
        background-color: darkmagenta;
        color: white;
        border-radius: 5em;
    }
</style>
<BaseLayout class="overflow-scroll">
<Breadcrumb items={breadcrumbs}/>
<h1 class="uppercase flex items-center gap-2 border-b-2 border-fuchsia-900 border-dotted mb-5 mt-2.5"> {work.title}</h1>
{
<Carousel items={work.image.length} className="max-h-80">
    { work.image.map((img:any) => (
    <li><Image src={img.url} alt={img.alt} width={200} height={200} class="w-full object-contain" loading="lazy" decoding="async"/></li>
))}
</Carousel>
}
<section>
    <div class="flex items-center">
        <div class="font-bold">Año</div>
        <div class="pl-4 py-2">{work.year}</div>
    </div>
    <div class="flex items-center">
        <div class="font-bold flex lg:table-cell">Categorías</div>
        <div class="pl-2.5"><Categories categories={work.category}/></div>
    </div>
</section>
<p>{work.description}</p>

{work.category.find((cat:any) => (cat === "audio"))?
<h2 class="mb-3">PREVIEW (Audio)</h2>
<audio src={work.exturl} controls controlslist="nodownload"/>
:
""
}

{work.category.find((cat:any) => (cat === "video"))?
<h2 class="mb-3">PREVIEW (Video)</h2>
<YouTube id={work.exturl}/>
:
""
}

{work.category.find((cat:any) => (cat === "programacion" || cat === "texto"))?
<h2 class="mb-3">PREVIEW</h2>
<a href={work.exturl} id="extbtn" class="inline-block uppercase bg-fuchsia-950 p-1.5 text-white px-2 m-1 rounded-sm">Link Externo</a>
:
""
}
<ws-widget type="comments" iid="26590"></ws-widget>
</BaseLayout>
