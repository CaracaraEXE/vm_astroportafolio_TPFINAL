---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { Carousel, Breadcrumb } from 'webcoreui/astro';
import Categories from "../components/Categories.astro";

const {work} = Astro.props;

const breadcrumbs = [
    {label: 'Proyectos', href: '/works'},
    {label: `${work.title}`, href: `/works/${work.slug}`}
]

---
<style>
    tr, td{
        height: fit-content;
    }
</style>
<BaseLayout>
<Breadcrumb items={breadcrumbs}/>
<h1 class="uppercase flex items-center gap-2 border-b-2 border-fuchsia-900 border-dotted mb-5"> {work.title}</h1>
{
/* work.image.map((img:any) => (
    <Image src={img.url} alt={img.alt} width={200} height={200}/>
))*/

<Carousel items={work.image.length} className="max-h-80">
    { work.image.map((img:any) => (
    <li><Image src={img.url} alt={img.alt} width={200} height={200} class="w-full object-contain" loading="lazy" decoding="async"/></li>
))}
</Carousel>
}
<table>
    <tr>
        <td class="font-bold">Año</td>
        <td class="pl-4 py-2">{work.year}</td>
    </tr>
    <tr>
        <td class="font-bold flex lg:table-cell">Categorías</td>
        <td class="pl-2.5"><Categories categories={work.category}/></td>
    </tr>
</table>
<p>{work.desc}</p>

</BaseLayout>