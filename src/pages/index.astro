---
import { Image } from 'astro:assets';
import '../styles/global.css';
import '../styles/hover.css';
import Icon from '../assets/svg/asterisk.svg';
import { Font } from "astro:assets";
import AvatarIcon from '../assets/images/gatito.png'
import SocMedNav from '../components/socMedNav.astro';
---
<style>

    *{
        font-family: var(--font-michroma);
    }

    a{
        display: flex;
        width:fit-content;
        align-items: center;
        gap:5px;
        height: 2em;
        transition:font-weight 0.25s ease;
        width: 10em;
    }

    a:hover{
        color:blueviolet;
        font-weight: bold;
    }

    .icon {
  opacity: 0;
  transition: opacity 0.3s ease;
}

li:hover .icon {
  opacity: 1;
}

</style>
<html>
    <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Test</title>
    <Font cssVariable="--font-michroma"/>
  </head>
  <body class="h-lvh flex justify-center items-center">
    <div class="bg-amber-200 h-fit flex flex-col lg:flex-row w-[15em] lg:w-[25em] gap-5 lg:gap-3 items-center rounded-lg p-25 fadeInUp-animation" style="padding: 2em;">
        <div class="flex flex-col items-center gap-2">
            <Image src={AvatarIcon} alt={"Icon"} width={100} height={100} class="rounded-full"/>
            <p class="text-1xl font-bold lg:text-[0.9em]">Herbertia Lahué</p>
            <SocMedNav/>
        </div>
        <nav>
            <ul>
                <li><a href="/about"><Icon width={15} height={15} fill={"#FFFFFF"} class="icon"/> <span class="hvr-underline-from-left">Sobre Mí</span></a></li>
                <li><a href="/works"><Icon width={15} height={15} fill={"#FFFFFF"} class="icon"/> <span class="hvr-underline-from-left">Proyectos</span></a></li>
                <li><a href="/links"><Icon width={15} height={15} fill={"#FFFFFF"} class="icon"/> <span class="hvr-underline-from-left">Directorio</span></a></li>
                 <li><a href="/souvenir"><Icon width={15} height={15} fill={"#FFFFFF"} class="icon"/> <span class="hvr-underline-from-left">Souvenir</span></a></li>
            </ul>
        </nav>
    </div>
  </body>
</html>