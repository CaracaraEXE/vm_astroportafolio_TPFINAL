---
import BaseLayout from "../layouts/BaseLayout.astro";
import '.././styles/global.css'

---
<BaseLayout>
    <h1>Souvenir</h1>
    <p>Antes de irte, dibuja lo que quieras y llevatelo de recuerdo!</p>
    <ws-widget type="draw" iid="26682" embed="iframe"></ws-widget>
    <div style="position: relative; width: 100%; max-width: 700px; aspect-ratio: 4/3;">
        <iframe 
        src="https://mintycake.nekoweb.org/draw" 
        width="600" 
        height="500" 
        style="border: 1px solid #ccc;"
        title="Drawing Tool"
        loading="lazy">
        </iframe>
    </div>
</BaseLayout>