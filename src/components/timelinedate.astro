---
import '../styles/global.css'
import Icon from '../assets/svg/schoolblue.svg'
const {title, place, date} = Astro.props;
---
<li class=" text-white flex items-center my-7 gap-2" >
        <div>
           <Icon width={50} height={50} fill={"currentColor"} class="text-fuchsia-950" />
        </div>
      <div class="flex items-center justify-start w-[80%]">
        <div class="w-3 overflow-hidden">
          <div class="h-4 bg-fuchsia-900 rotate-45 transform origin-bottom-right rounded-sm"></div>
        </div>
        <div class="bg-fuchsia-900 p-4 rounded-lg flex-1">
            <p class="lg:text-[1.05em] text-[1em]"><strong>{place}</strong></p>
            <p class="lg:text-[0.95em] text-[0.75em]">{title}</p>
            <p class="lg:text-[0.60em] text-[0.50em]">{date}</p>
        </div>
      </div>

    </li>