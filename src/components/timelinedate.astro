---
import '../styles/global.css'
import icon from '../../src/assets/svg/schoolblue.svg'
import { Image } from 'astro:assets';
const {title, place, date} = Astro.props;
---
<li class=" text-white flex w-[60%] my-10" >
        <div>
           <Image src={icon} alt={"Icon school"}/>
        </div>
        <div class="bg-fuchsia-950 hvr-bubble-float-left">
            <p>{title}</p>
            <p>{place}</p>
            <p>{date}</p>
        </div>
    </li>