---
import Icon from '../assets/svg/asterisk.svg';
import '../styles/global.css';
import SocMedNav from './socMedNav.astro';

---
<style>

    *{
        font-family: var(--font-michroma);
    }

    a{
        display: flex;
        width:fit-content;
        align-items: center;
        gap:5px;
        height: 2em;
        transition:font-weight 0.25s ease;
    }

    a:hover{
        color:blueviolet;
        font-weight: bold;
    }

    .icon {
  opacity: 0;
  transition: opacity 0.3s ease;
}

li:hover .icon {
  opacity: 1;
}


@keyframes fadeInUp {
  0% {
    transform: translateY(100%);
    opacity: 0;
  }
  100% {
    transform: translateY(0%);
    opacity: 1;
  }
}

.fadeInUp-animation {
  animation: 1.5s fadeInUp;
}

li{
  font-size: 0.75em;
}

.sub-menu{
  display: grid;
  grid-template-rows: 0fr;
  transition: 300ms ease-in-out;

  > div{
    overflow: hidden;
  }
}

.sub-menu.show{
  grid-template-rows: 1fr;
}

</style>
<nav>
    <ul>
        <li>
          <a href="/about" class="font-bold" id="aboutbutton"><Icon width={15} height={15}  class="icon"/>Sobre mí</a>
        <button class="dropdown-opener">Open</button>
          <ul class="ml-5 sub-menu">
          <div>
            <li><a href="/about#bio"><Icon width={15} height={15}  class="icon"/><span class="hvr-underline-from-left">Biografía</span></a></li>
            <li><a href="/about#past"><Icon width={15} height={15}  class="icon"/>Experiencia</a></li>
            <li><a href="/about#skills"><Icon width={15} height={15}  class="icon"/>Habilidades</a></li>
          </div>
          </ul>
        </li>
        <li>
          <a href="/works" class="font-bold" id="worksbutton"><Icon width={15} height={15}  class="icon"/>Proyectos</a>
          <button class="dropdown-opener">Open</button>

          <ul class="ml-5 sub-menu">
            <div>
              <li><a href="/about#bio"><Icon width={15} height={15}  class="icon"/><span class="hvr-underline-from-left">Audio</span></a></li>
              <li><a href="/about#past"><Icon width={15} height={15}  class="icon"/>Video</a></li>
                            <li><a href="/about#past"><Icon width={15} height={15}  class="icon"/>Image</a></li>
            </div>
          </ul>
        </li>
        <li><a href="/links" class="font-bold"><Icon width={15} height={15}  class="icon"/>Links</a></li>
        <li><a href="/souvenir" class="font-bold"><Icon width={15} height={15}  class="icon"/>Souvenir</a></li>
    </ul>
</nav>
<script>
    const dropBtns = document.querySelectorAll(".dropdown-opener");

    dropBtns.forEach((btn) => {
      btn.addEventListener('click',() => {
        const subMenu = btn.nextElementSibling;
        subMenu? subMenu.classList.toggle('show') : "";
      })
    })

    console.log(dropBtns);
</script>