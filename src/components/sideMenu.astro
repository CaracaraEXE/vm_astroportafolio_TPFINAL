---
import Icon from '../assets/svg/asterisk.svg';
import Arrow from '../assets/svg/charm--arrow-down-right.svg';
import '../styles/global.css';

---
<style>

    *{
        font-family: var(--font-michroma);
    }

    a, button{
        display: flex;
        width:fit-content;
        align-items: center;
        gap:2px;
        height: 2em;
        transition:font-weight 0.25s ease;
        font-weight: bold;
    }

    button{
      gap:0;
    }

    li a:hover, button:hover{
      color:blueviolet;
      font-weight: bold;
    }

    .icon {
      transition: opacity 0.3s ease;
    }

button:hover .icon, a:hover .icon {
  opacity: 1;
}


@keyframes fadeInUp {
  0% {
    transform: translateY(100%);
    opacity: 0;
  }
  100% {
    transform: translateY(0%);
    opacity: 1;
  }
}

.fadeInUp-animation {
  animation: 1.5s fadeInUp;
}

</style>
<script>
  import "../scripts/dropdown.js"
</script>
<nav class="lg:mt-5">
    <ul>
        <li>
          <button class="dropdown-opener gap-0 text-2xl lg:text-[1em]"><Arrow width={20} height={25} fill={"currentColor"} class="icon opacity-100 lg:opacity-0 cursor-pointer scale-125"/><a href="/about">Sobre mí</a></button>
          <ul class="ml-5 sub-menu">
          <div>
            <li class="text-1xl lg:text-[0.75em]"><a href="/about#bio"><Icon width={15} height={15} fill={"currentColor"} class="icon opacity-100 lg:opacity-0 scale-95"/><span class="hvr-underline-from-left">Biografía</span></a></li>
            <li class="lg:text-[0.75em]"><a href="/about#past"><Icon width={15} height={15} fill={"currentColor"} class="icon opacity-100 lg:opacity-0 scale-95"/><span class="hvr-underline-from-left">Experiencia</span></a></li>
            <li class="lg:text-[0.75em]"><a href="/about#skills"><Icon width={15} height={15} fill={"currentColor"} class="icon opacity-100 lg:opacity-0 scale-95"/><span class="hvr-underline-from-left">Habilidades</span></a></li>
          </div>
          </ul>
        </li>
        <li>
          <button class="dropdown-opener gap-0 text-2xl lg:text-[1em]"><Arrow width={20} height={20} class="icon opacity-100 lg:opacity-0 scale-125"/><a href="/about">Sobre mí</a></button>
