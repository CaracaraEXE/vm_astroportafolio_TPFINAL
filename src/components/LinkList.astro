import { createServerClient } from "../lib/supabase";

const supabase = createServerClient();
const { data:linkList, error } = await supabase.from('linklist') .select('*')

const categories = [...new Set(linkList?.map(item => item.category))];


---
<section class="lg:w-[80%]">
{categories.map(cat =>
    <LinkItem category={cat}/>
)}
</section>