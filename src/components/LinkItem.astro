---
import Arrow from '.././assets/svg/charm--arrow-down.svg'
import Icon from '../assets/svg/asterisk.svg';
import '../styles/global.css';
import ListBackup from '../data/linklist.json'
import { createServerClient } from "../lib/supabase";

const supabase = createServerClient();
const { data:linkList, error } = await supabase.from('linklist') .select('*')

const {category} = Astro.props;

let links

linkList?
links = linkList?.filter(item => item.category === category)
:
links = ListBackup?.filter(item => item.category === category);

---
<style>
    a{
        font-family: 'Michroma';
    }
</style>
<script>
    import '../scripts/dropdown.js'
</script>
<div class="mb-2.5">
    <button class="link-item dropdown-opener text-1xl flex justify-between hover:bg-fuchsia-900 cursor-pointer bg-fuchsia-950  text-white w-full px-5 py-5 lg:py-2.5 transform-all duration-75">
    <h3>{category}</h3>
    <Arrow width={20} height={20}/>
    </button>
    <section class="sub-menu">
        <div>
            <ul>
            {
                links?.map(link =>
                    <li class="flex flex-col lg:flex-row my-2 lg:items-end border-b-2 border-dotted border-fuchsia-900 lg:gap-2"><a href={link.url} class="text-[1.25em] lg:text-[1em] text-fuchsia-900 uppercase leading-6 flex gap-1 font-black hover:tracking-wide transform-all duration-75"><Icon width={20} height={20} fill={"currentColor"} class="icon opacity-100"/> {link.name}</a><span class="text-[0.75em]">{link.description}</span></li>
                )
            }
            </ul>
        </div>
    </section>
</div>