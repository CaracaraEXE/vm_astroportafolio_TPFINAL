---
import Arrow from '.././assets/svg/charm--arrow-down.svg'
import List from '../assets/linklist.json';
import '../styles/global.css';

const {category} = Astro.props;

const links = List.filter(item => item.category === category);
---
<script>
    import '../scripts/dropdown.js'
</script>
<button class="dropdown-opener">
<h3>{category}</h3>
<Arrow width={25} height={25}/>
</button>
<ul class="sub-menu">
    <div>
        {
            links.map(link =>
                <li class="flex flex-col"><a href={link.url} class="border-b-2 border-fuchsia-900 border-dotted">{link.name}</a><span>{link.desc}</span></li>
            )
        }
    </div>
</ul>