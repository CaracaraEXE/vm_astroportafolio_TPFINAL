---
import GalleryItem  from "./GalleryItem.astro";

const {works} = Astro.props;
---
<div class="masonry-container lg:columns-3 space-y-3 w-fit">
        {works?
        
        works.map((work:any) =>
            <GalleryItem work={work}/>
        )
    
        :

        <p>Hubo un error al conseguir la data. Contactame por email si el problema persiste!</p>
    }
</div>
