---
import IconAni from '../assets/svg/skills/boxicons--animation-bounce-filled.svg'
import IconCode from '../assets/svg/skills/boxicons--code.svg'
import Icon3D from '../assets/svg/skills/boxicons--cube.svg'
import IconImage from '../assets/svg/skills/boxicons--image.svg'
import IconVideo from '../assets/svg/skills/boxicons--film.svg'
import IconDraw from '../assets/svg/skills/boxicons--pencil-draw-filled.svg'
import Arrow from '../assets/svg/charm--arrow-down.svg'

---
<style>

    ul{
        list-style-image: url('../assets/svg/asterisk.svg');
        padding-left: 1.5em;
    }

    .skill{
        width: fit-content;
        max-width: 10em;
    }

    .icon{
        width: fit-content;
    }

    h3{
        color: darkmagenta;
        font-weight: bold;
        text-transform: uppercase;
        margin-top: 0.5em;
    }

    svg{
        color:white;
    }

    a svg{
        color:black;
    }

    ul{
        margin-bottom: 0.5em;
    }

    @media screen and (min-width: 636px) {
        li{
            font-size: 0.85em;
        }

        .skill{
                    max-width: 20em;
        }
    }
</style>
<section class="grid grid-cols-2 lg:grid-cols-4 gap-x-5 lg:gap-y-8 gap-y-5 lg:w-[90%] my-3 lg:my-6 ml-5">
<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5">
        <IconDraw width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3>Ilustración</h3>
    <ul>
        <li>Adobe Photoshop</li>
        <li>Firealpaca</li>
        <li>Medibang Paint</li>
    </ul>
    <a href="/works/tags/ilustracion" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5 ">
        <IconImage width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3>Diseño</h3>
    <ul>
        <li>Figma</li>
        <li>Adobe Illustrator</li>
        <li>Adobe Photoshop</li>
    </ul>
        <a href="/works/tags/diseño" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5">
        <IconVideo width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3>Edición de Video</h3>
    <ul>
        <li>Adobe After Effects</li>
        <li>Shotcut</li>
    </ul>
    <a href="/works/tags/video" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5 w-fit">
        <IconCode width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3 class="text-[0.75em] lg:text-[1em]">Programación</h3>
    <ul>
        <li>HTML/CSS/JS</li>
        <li>NextJS</li>
        <li>React</li>
        <li>AstroJS</li>
        <li>Tailwind</li>
    </ul>
    <a href="/works/tags/programacion" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5 ">
        <Icon3D width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3>Modelado 3D</h3>
    <ul>
        <li>Blender</li>
        <li>Firealpaca</li>
    </ul>
    <a href="/works/tags/3D" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

<div class="skill">
    <div class="icon rounded-full bg-fuchsia-950 p-2.5">
        <IconAni width={30} height={30} fill={"currentColor"}/>
    </div>
    <h3>Animación</h3>
    <ul>
        <li>Adobe After Effects</li>
        <li>Adobe Animate</li>
        <li>Stop-motion</li>
    </ul>
    <a href="/works/tags/animacion" class="flex items-center gap-1 text-[0.85em] font-bold mt-2.5"><span class="hvr-underline-from-left">Ver más</span> <Arrow width={20} height={20} fill="currentColor" class="rotate-270"/></a>
</div>

</section>