---
import SideMenu from "./sideMenu.astro";
import SocMedNav from "./socMedNav.astro";
import Asterisk from '../assets/svg/asterisk.svg';
import "../styles/global.css";
import "../styles/hover.css"
import herb from '../assets/images/menu1.png'

---
<style>
    
    *{
              font-family: 'Michroma';
    }

    a:hover{
      color:darkmagenta;
      font-weight: bold;
    }

    
    @media screen and (min-width: 636px) {
  ul{
      grid-template-rows: 1fr;
  }
}
</style>
<header class="lg:flex lg:flex-col lg:h-full lg:flex-end pl-8 lg:p-5 pt-8 lg:pr-6 lg:max-w-[30em] lg:bg-bottom lg:bg-cover" style={`background-image: url('${herb.src}');`}>
        <button class="dropdown-opener cursor-pointer hvr-icon-rotate"><Asterisk width={30} height={30} fill={"currentColor"} class="hover:text-fuchsia-900 hvr-icon"/></button>
    <ul class="sub-menu">
    <div>
        <SideMenu/>
        <a href="/credits" class="font-bold lg:text-[0.75em] hvr-underline-from-left lg:mb-1">Créditos</a>
        <SocMedNav/>
    </div>
    </ul>
</header>