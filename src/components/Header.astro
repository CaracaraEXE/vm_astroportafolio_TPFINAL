---
import SideMenu from "./sideMenu.astro";
import SocMedNav from "./socMedNav.astro";
import Asterisk from '../assets/svg/asterisk.svg';
import Arrow from '../assets/svg/charm--arrow-down.svg';
import "../styles/global.css";
import "../styles/hover.css"
---
<style>
    @media screen and (min-width: 636px) {
  ul{
      grid-template-rows: 1fr;
  }
}
</style>
<header class="lg:flex lg:flex-col lg:max-h-lvh lg:flex-end pl-8 lg:p-5 pt-8 lg:pr-6 lg:max-w-[30em]">
        <button class="dropdown-opener cursor-pointer hvr-icon-rotate"><Asterisk width={30} height={30} fill={"currentColor"} class="hover:text-violet-800 hvr-icon"/></button>
    <ul class="sub-menu">
    <div>
        <SideMenu/>
        <a href="/credits" class="font-bold lg:text-[0.75em]">Créditos</a>
        <SocMedNav/>
    </div>
    </ul>
</header>